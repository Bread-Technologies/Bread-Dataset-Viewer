{
  "name": "bread-dataset-viewer",
  "displayName": "Bread Dataset Viewer - Open Source",
  "description": "Open Source dataset viewer for ML engineers. View 100GB+ JSONL/Parquet/CSV files with real-time token counting using 16 LLM tokenizers.",
  "version": "0.1.4",
  "publisher": "bread-tech",
  "license": "MIT",
  "icon": "bread_dataset_logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bread-Technologies/mle_vscode_extension"
  },
  "bugs": {
    "url": "https://github.com/Bread-Technologies/mle_vscode_extension/issues"
  },
  "keywords": [
    "jsonl",
    "json",
    "csv",
    "parquet",
    "arrow",
    "feather",
    "dataset",
    "large files",
    "big data",
    "token counting",
    "llm",
    "training data",
    "data viewer",
    "lazy loading",
    "tokenizer",
    "gpt",
    "claude",
    "llama",
    "qwen",
    "chat completions",
    "open source",
    "fast",
    "performance",
    "data viewer",
    "data visualization",
    "data exploration",
    "data analysis",
    "data processing",
    "data engineering",
    "artificial intelligence",
    "data science",
    "machine learning",
    "ml",
    "ai",
    "artificial intelligence",
    "chat completions",
    "ml ops",
    "mlops",
    "ml operations",
    "ml engineering",
    "machine learning engineering"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Machine Learning",
    "Visualization",
    "Formatters"
  ],
  "activationEvents": [
    "onCustomEditor:mlWorkbench.jsonlViewer",
    "onCustomEditor:mlWorkbench.jsonViewer",
    "onCustomEditor:mlWorkbench.parquetViewer",
    "onCustomEditor:mlWorkbench.csvViewer",
    "onCustomEditor:mlWorkbench.arrowViewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mlWorkbench.openTextViewer",
        "title": "Open Text Viewer (Fast, All Formats)",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.setMode",
        "title": "Text Viewer: Set Mode",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.nextPage",
        "title": "Text Viewer: Next Page",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.prevPage",
        "title": "Text Viewer: Previous Page",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.search",
        "title": "Text Viewer: Search",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.gotoLine",
        "title": "Text Viewer: Go to Line",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.openInEditor",
        "title": "Text Viewer: Open File for Editing",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.setTokenizer",
        "title": "Text Viewer: Set Tokenizer",
        "category": "Bread"
      }
    ],
    "customEditors": [
      {
        "viewType": "mlWorkbench.jsonlViewer",
        "displayName": "JSONL Viewer",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mlWorkbench.jsonViewer",
        "displayName": "JSON Viewer",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mlWorkbench.parquetViewer",
        "displayName": "Parquet Viewer",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mlWorkbench.csvViewer",
        "displayName": "CSV/TSV Viewer",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mlWorkbench.arrowViewer",
        "displayName": "Arrow IPC Viewer",
        "selector": [
          {
            "filenamePattern": "*.arrow"
          },
          {
            "filenamePattern": "*.feather"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "jsonl",
        "extensions": [
          ".jsonl"
        ],
        "aliases": [
          "JSONL",
          "JSON Lines"
        ]
      },
      {
        "id": "parquet",
        "extensions": [
          ".parquet"
        ],
        "aliases": [
          "Parquet",
          "Apache Parquet"
        ]
      },
      {
        "id": "csv",
        "extensions": [
          ".csv"
        ],
        "aliases": [
          "CSV",
          "Comma-Separated Values"
        ]
      },
      {
        "id": "tsv",
        "extensions": [
          ".tsv"
        ],
        "aliases": [
          "TSV",
          "Tab-Separated Values"
        ]
      },
      {
        "id": "arrow",
        "extensions": [
          ".arrow"
        ],
        "aliases": [
          "Arrow IPC",
          "Apache Arrow"
        ]
      },
      {
        "id": "feather",
        "extensions": [
          ".feather"
        ],
        "aliases": [
          "Feather",
          "Arrow Feather"
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mlWorkbench.openTextViewer",
          "when": "resourceExtname =~ /\\.(jsonl|json|csv|tsv|parquet|arrow|feather)$/",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.22.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@dsnp/parquetjs": "^1.8.7",
    "@huggingface/transformers": "^3.8.1",
    "@vscode/extension-telemetry": "^1.4.0",
    "apache-arrow": "^21.1.0",
    "csv-parser": "^3.2.0",
    "katex": "^0.16.28",
    "markdown-it": "^14.1.0"
  }
}
