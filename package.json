{
  "name": "ml-workbench",
  "displayName": "ML Workbench",
  "description": "View JSONL datasets and chat with local models",
  "version": "0.1.0",
  "publisher": "ml-workbench",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Data Science",
    "Visualization"
  ],
  "activationEvents": [
    "onCustomEditor:mlWorkbench.jsonlViewer",
    "onCustomEditor:mlWorkbench.modelChat",
    "onCommand:mlWorkbench.openJsonlFast"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mlWorkbench.openJsonlFast",
        "title": "Open JSONL Viewer (Fast Reused Webview)"
      }
    ],
    "customEditors": [
      {
        "viewType": "mlWorkbench.jsonlViewer",
        "displayName": "JSONL Viewer",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mlWorkbench.modelChat",
        "displayName": "Chat with Model",
        "selector": [
          {
            "filenamePattern": "*.gguf"
          },
          {
            "filenamePattern": "*.safetensors"
          }
        ],
        "priority": "option"
      }
    ],
    "languages": [
      {
        "id": "jsonl",
        "extensions": [
          ".jsonl"
        ],
        "aliases": [
          "JSONL",
          "JSON Lines"
        ]
      },
      {
        "id": "gguf",
        "extensions": [
          ".gguf"
        ],
        "aliases": [
          "GGUF Model"
        ]
      },
      {
        "id": "safetensors",
        "extensions": [
          ".safetensors"
        ],
        "aliases": [
          "Safetensors Model"
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mlWorkbench.openJsonlFast",
          "when": "resourceExtname == .jsonl",
          "group": "navigation@11"
        }
      ],
      "editor/title": [
        {
          "command": "mlWorkbench.openJsonlFast",
          "when": "resourceExtname == .jsonl",
          "group": "navigation@11"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "tiktoken": "^1.0.0"
  }
}
