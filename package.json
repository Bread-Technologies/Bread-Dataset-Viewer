{
  "name": "ml-workbench",
  "displayName": "ML Workbench",
  "description": "View JSONL datasets with accurate token counting for ML training data",
  "version": "0.1.0",
  "publisher": "ml-workbench",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Data Science",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:jsonl",
    "onLanguage:json",
    "onLanguage:parquet",
    "onLanguage:csv",
    "onLanguage:tsv",
    "onLanguage:arrow",
    "onLanguage:feather",
    "workspaceContains:**/*.jsonl",
    "workspaceContains:**/*.parquet",
    "workspaceContains:**/*.arrow",
    "workspaceContains:**/*.feather",
    "workspaceContains:**/*.csv",
    "workspaceContains:**/*.tsv",
    "onCustomEditor:mlWorkbench.jsonlViewer",
    "onCommand:mlWorkbench.openWebviewViewer",
    "onCommand:mlWorkbench.openJsonlFast",
    "onCommand:mlWorkbench.openJsonlTextViewer",
    "onCommand:mlWorkbench.jsonlText.setMode",
    "onCommand:mlWorkbench.jsonlText.nextPage",
    "onCommand:mlWorkbench.jsonlText.prevPage",
    "onCommand:mlWorkbench.jsonlText.search",
    "onCommand:mlWorkbench.jsonlText.gotoLine",
    "onCommand:mlWorkbench.jsonlText.openInEditor",
    "onCommand:mlWorkbench.jsonlText.setTokenizer",
    "onCustomEditor:mlWorkbench.jsonViewer",
    "onCustomEditor:mlWorkbench.parquetViewer",
    "onCustomEditor:mlWorkbench.csvViewer",
    "onCustomEditor:mlWorkbench.arrowViewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mlWorkbench.openJsonlFast",
        "title": "Open JSONL Viewer (Fast Reused Webview)"
      },
      {
        "command": "mlWorkbench.openJsonlTextViewer",
        "title": "Open JSONL Viewer (Text, Fast)"
      },
      {
        "command": "mlWorkbench.jsonlText.setMode",
        "title": "JSONL Text Viewer: Set Mode",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.jsonlText.nextPage",
        "title": "JSONL Text Viewer: Next Page",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.jsonlText.prevPage",
        "title": "JSONL Text Viewer: Previous Page",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.jsonlText.search",
        "title": "JSONL Text Viewer: Search",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.jsonlText.gotoLine",
        "title": "JSONL Text Viewer: Go to Line",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.jsonlText.openInEditor",
        "title": "JSONL Text Viewer: Open File for Editing",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.jsonlText.setTokenizer",
        "title": "JSONL Text Viewer: Set Tokenizer",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.openTextViewer",
        "title": "Open Text Viewer (Fast, All Formats)",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.textViewer.setMode",
        "title": "Text Viewer: Set Mode",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.textViewer.nextPage",
        "title": "Text Viewer: Next Page",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.textViewer.prevPage",
        "title": "Text Viewer: Previous Page",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.textViewer.search",
        "title": "Text Viewer: Search",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.textViewer.gotoLine",
        "title": "Text Viewer: Go to Line",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.textViewer.openInEditor",
        "title": "Text Viewer: Open File for Editing",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.textViewer.setTokenizer",
        "title": "Text Viewer: Set Tokenizer",
        "category": "ML Workbench"
      },
      {
        "command": "mlWorkbench.openWebviewViewer",
        "title": "Open in Rich Viewer (Webview)",
        "category": "ML Workbench"
      }
    ],
    "customEditors": [
      {
        "viewType": "mlWorkbench.jsonlViewer",
        "displayName": "JSONL Viewer",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "mlWorkbench.jsonViewer",
        "displayName": "JSON Viewer",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "mlWorkbench.parquetViewer",
        "displayName": "Parquet Viewer",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mlWorkbench.csvViewer",
        "displayName": "CSV/TSV Viewer",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "mlWorkbench.arrowViewer",
        "displayName": "Arrow IPC Viewer",
        "selector": [
          {
            "filenamePattern": "*.arrow"
          },
          {
            "filenamePattern": "*.feather"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "jsonl",
        "extensions": [
          ".jsonl"
        ],
        "aliases": [
          "JSONL",
          "JSON Lines"
        ]
      },
      {
        "id": "parquet",
        "extensions": [
          ".parquet"
        ],
        "aliases": [
          "Parquet",
          "Apache Parquet"
        ]
      },
      {
        "id": "csv",
        "extensions": [
          ".csv"
        ],
        "aliases": [
          "CSV",
          "Comma-Separated Values"
        ]
      },
      {
        "id": "tsv",
        "extensions": [
          ".tsv"
        ],
        "aliases": [
          "TSV",
          "Tab-Separated Values"
        ]
      },
      {
        "id": "arrow",
        "extensions": [
          ".arrow"
        ],
        "aliases": [
          "Arrow IPC",
          "Apache Arrow"
        ]
      },
      {
        "id": "feather",
        "extensions": [
          ".feather"
        ],
        "aliases": [
          "Feather",
          "Arrow Feather"
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mlWorkbench.openWebviewViewer",
          "when": "resourceExtname =~ /\\.(jsonl|json|csv|tsv|parquet|arrow|feather)$/",
          "group": "navigation@10"
        }
      ],
      "editor/title": [
        {
          "command": "mlWorkbench.openWebviewViewer",
          "when": "resourceExtname =~ /\\.(jsonl|json|csv|tsv|parquet|arrow|feather)$/ || resourceScheme == data-text-view || resourceScheme == jsonl-view",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.22.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@dsnp/parquetjs": "^1.8.7",
    "@huggingface/transformers": "^3.8.1",
    "apache-arrow": "^21.1.0",
    "csv-parser": "^3.2.0",
    "katex": "^0.16.28",
    "markdown-it": "^14.1.0"
  }
}
