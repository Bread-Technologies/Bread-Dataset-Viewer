{
  "name": "bread-dataset-viewer",
  "displayName": "Bread Dataset Viewer",
  "description": "View massive JSONL, CSV, Parquet, and Arrow files instantly without freezing VS Code. Includes ML token counting.",
  "version": "0.1.0",
  "publisher": "bread-tech",
  "license": "MIT",
  "icon": "bread_dataset_logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/mle_vscode_extension"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/mle_vscode_extension/issues"
  },
  "keywords": [
    "jsonl",
    "json",
    "csv",
    "parquet",
    "arrow",
    "dataset",
    "large files",
    "token counting",
    "ml",
    "machine learning",
    "data viewer",
    "lazy loading"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Machine Learning",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:mlWorkbench.jsonlViewer",
    "onCustomEditor:mlWorkbench.jsonViewer",
    "onCustomEditor:mlWorkbench.parquetViewer",
    "onCustomEditor:mlWorkbench.csvViewer",
    "onCustomEditor:mlWorkbench.arrowViewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mlWorkbench.openTextViewer",
        "title": "Open Text Viewer (Fast, All Formats)",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.setMode",
        "title": "Text Viewer: Set Mode",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.nextPage",
        "title": "Text Viewer: Next Page",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.prevPage",
        "title": "Text Viewer: Previous Page",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.search",
        "title": "Text Viewer: Search",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.gotoLine",
        "title": "Text Viewer: Go to Line",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.openInEditor",
        "title": "Text Viewer: Open File for Editing",
        "category": "Bread"
      },
      {
        "command": "mlWorkbench.textViewer.setTokenizer",
        "title": "Text Viewer: Set Tokenizer",
        "category": "Bread"
      }
    ],
    "customEditors": [
      {
        "viewType": "mlWorkbench.jsonlViewer",
        "displayName": "JSONL Viewer",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mlWorkbench.jsonViewer",
        "displayName": "JSON Viewer",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mlWorkbench.parquetViewer",
        "displayName": "Parquet Viewer",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mlWorkbench.csvViewer",
        "displayName": "CSV/TSV Viewer",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mlWorkbench.arrowViewer",
        "displayName": "Arrow IPC Viewer",
        "selector": [
          {
            "filenamePattern": "*.arrow"
          },
          {
            "filenamePattern": "*.feather"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "jsonl",
        "extensions": [
          ".jsonl"
        ],
        "aliases": [
          "JSONL",
          "JSON Lines"
        ]
      },
      {
        "id": "parquet",
        "extensions": [
          ".parquet"
        ],
        "aliases": [
          "Parquet",
          "Apache Parquet"
        ]
      },
      {
        "id": "csv",
        "extensions": [
          ".csv"
        ],
        "aliases": [
          "CSV",
          "Comma-Separated Values"
        ]
      },
      {
        "id": "tsv",
        "extensions": [
          ".tsv"
        ],
        "aliases": [
          "TSV",
          "Tab-Separated Values"
        ]
      },
      {
        "id": "arrow",
        "extensions": [
          ".arrow"
        ],
        "aliases": [
          "Arrow IPC",
          "Apache Arrow"
        ]
      },
      {
        "id": "feather",
        "extensions": [
          ".feather"
        ],
        "aliases": [
          "Feather",
          "Arrow Feather"
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mlWorkbench.openTextViewer",
          "when": "resourceExtname =~ /\\.(jsonl|json|csv|tsv|parquet|arrow|feather)$/",
          "group": "navigation@10"
        }
      ],
      "editor/title": [
        {
          "command": "mlWorkbench.openTextViewer",
          "when": "resourceExtname =~ /\\.(jsonl|json|csv|tsv|parquet|arrow|feather)$/ || resourceScheme == data-text-view",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.22.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@dsnp/parquetjs": "^1.8.7",
    "@huggingface/transformers": "^3.8.1",
    "apache-arrow": "^21.1.0",
    "csv-parser": "^3.2.0",
    "katex": "^0.16.28",
    "markdown-it": "^14.1.0"
  }
}
