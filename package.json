{
  "name": "ml-workbench",
  "displayName": "ML Workbench",
  "description": "View JSONL datasets and chat with local models",
  "version": "0.1.0",
  "publisher": "ml-workbench",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Data Science",
    "Visualization"
  ],
  "activationEvents": [
    "onCustomEditor:mlWorkbench.jsonlViewer",
    "onCustomEditor:mlWorkbench.modelChat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "mlWorkbench.jsonlViewer",
        "displayName": "JSONL Viewer",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mlWorkbench.modelChat",
        "displayName": "Chat with Model",
        "selector": [
          {
            "filenamePattern": "*.gguf"
          },
          {
            "filenamePattern": "*.safetensors"
          }
        ],
        "priority": "option"
      }
    ],
    "languages": [
      {
        "id": "jsonl",
        "extensions": [
          ".jsonl"
        ],
        "aliases": [
          "JSONL",
          "JSON Lines"
        ]
      },
      {
        "id": "gguf",
        "extensions": [
          ".gguf"
        ],
        "aliases": [
          "GGUF Model"
        ]
      },
      {
        "id": "safetensors",
        "extensions": [
          ".safetensors"
        ],
        "aliases": [
          "Safetensors Model"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.22.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "katex": "^0.16.28",
    "markdown-it": "^14.1.0",
    "tiktoken": "^1.0.0"
  }
}
