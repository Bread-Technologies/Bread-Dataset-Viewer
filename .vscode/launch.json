{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile",
      "env": {
        "APP_INSIGHTS_KEY": "${env:APP_INSIGHTS_KEY}"
      }
    },
    {
      "name": "Run Extension (without build)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "env": {
        "APP_INSIGHTS_KEY": "${env:APP_INSIGHTS_KEY}"
      }
    }
  ]
}
